{
  "name": "prestruct",
  "version": "1.2.0",
  "description": "AI-first SEO prerender for Vite + React apps. Drop in, config, build.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "main": "engine/scripts/prerender.js",
  "bin": {
    "prestruct": "bin/cli.mjs"
  },
  "exports": {
    ".": "./engine/scripts/prerender.js",
    "./bin": "./bin/cli.mjs",
    "./prerender": "./engine/scripts/prerender.js",
    "./inject-brand": "./engine/scripts/inject-brand.js",
    "./audit": "./engine/scripts/audit.js",
    "./validate-config": "./engine/scripts/validate-config.js",
    "./hooks": "./engine/src/hooks/usePageMeta.js",
    "./islands": "./engine/src/islands.js",
    "./engine/*": "./engine/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "engine/",
    "init/",
    "!init/node_modules",
    "!init/dist",
    "!init/.prestruct"
  ],
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "npm run gate",
    "gate": "npm run sync:check && npm run lint:packs && npm run lint:docs && npm run lint:claims && npm --prefix init run lint && npm run test:run",
    "sync": "node scripts/sync-engine.mjs",
    "sync:check": "node scripts/sync-engine.mjs check",
    "lint:packs": "packstruct lint packs/ --deep",
    "crashtest:bump": "node scripts/crashtest-bump.mjs",
    "lint:docs": "node scripts/check-docs-style.cjs && node scripts/check-docs-links.cjs && node scripts/check-docs-frontmatter.cjs && node scripts/check-language.cjs && node scripts/check-docs-truthfulness.cjs",
    "lint:claims": "node scripts/check-fiction-signatures.cjs",
    "e2e": "node tests/e2e-fixture.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "tinypool": "^2.2.0"
  },
  "peerDependencies": {
    "react": ">=18 <19",
    "react-dom": ">=18 <19",
    "react-router-dom": ">=6 <8",
    "vite": ">=5 <8"
  },
  "devDependencies": {
    "crashtest": "1.1.0",
    "express": "^4.22.3",
    "happy-dom": "^21.0.4",
    "packstruct": "1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "react-router-dom-v7": "npm:react-router-dom@^7.18.5",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhaupin/prestruct.git"
  },
  "keywords": [
    "seo",
    "prerender",
    "vite",
    "react",
    "ssr",
    "static-site-generation",
    "cloudflare-pages"
  ],
  "bugs": {
    "url": "https://github.com/dhaupin/prestruct/issues"
  },
  "homepage": "https://github.com/dhaupin/prestruct#readme"
}
