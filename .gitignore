# Environment config - copy ssr.config.example.js to this file
ssr.config.js
.env
.env.*

# Dependencies (gitignored node_modules were committed earlier)
node_modules/

# Build output (any workspace: init/, example/, user projects)
dist/

# Prerender incremental cache (generated at build time; the `**` anchors the
# pattern to any depth - the earlier `.prestruct/cache/` form was root-anchored
# and silently missed nested workspaces like example/)
**/.prestruct/cache/
**/.prestruct/status.json

# Proxy disk cache (default location when PRESTRUCT_CACHE_DIR is not set)
.prestruct_cache/

# Test tooling
coverage/
.vite/

# OS + editor noise
.DS_Store
Thumbs.db
*.log
*.swp
beta/

# Local docs toolchain (the Jekyll preview recipe runs from a scratch copy +
# a Bundler path outside the repo, so these should never appear in-tree;
# belt-and-suspenders so an accidental in-tree build taints nothing).
docs/.bundle/
docs/vendor/
docs/_site/
docs/Gemfile.lock
