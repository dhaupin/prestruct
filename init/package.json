{
  "name": "prestruct",
  "version": "1.2.0",
  "description": "Build-time SEO prerender layer for Vite + React + Cloudflare Pages",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/inject-brand.js && node scripts/prerender.js && node scripts/audit-if-configured.cjs",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --ext js,mjs",
    "lint:fix": "eslint . --ext js,mjs --fix"
  },
  "overrides": {
    "tinypool": "^2.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6",
    "vite": ">=5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.0.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  }
}
