{
  "name": "prestruct",
  "version": "1.5.1",
  "description": "Build-time SEO prerender layer for Vite + React + Cloudflare Pages",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/inject-brand.js && node scripts/prerender.js && node scripts/audit-if-configured.cjs",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --ext js,mjs",
    "lint:fix": "eslint . --ext js,mjs --fix"
  },
  "overrides": {
    "tinypool": "^2.2.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "react-router-dom": ">=6 <8",
    "vite": ">=5 <9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "vite": "^8.3.7",
    "vitest": "^5.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.1"
  }
}
