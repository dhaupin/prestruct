 export function generateRobots(config, outputDir) {
   const sitemapUrl = pageUrlFor(config, 'sitemap.xml');
-  const robots = '# Robots.txt\nUser-agent: *\nAllow: /\n\nSitemap: ' + sitemapUrl + '\n';
+  const robotsCfg = config.robots;
+  const aeo = (typeof robotsCfg === 'object' && robotsCfg !== null && !Array.isArray(robotsCfg)
+    && robotsCfg.aeo === true);
+  let robots;
+  if (aeo) {
+    // The preset groups the host reads first (search surfaces), then the
+    // training verdict, then the always-on sitemap pointer. robots: true,
+    // absent and false all keep the all-open default (this engine OWNS
+    // robots.txt, unlike prestruct where the author's copy is untouchable,
+    // so false has nothing to "untouch" - the key only switches the preset).
+    const lines = [];
+    for (const bot of AEO_SEARCH_BOTS) lines.push('User-agent: ' + bot, 'Allow: /', '');
+    const verdict = robotsCfg.aiBots === 'allow' ? 'Allow: /' : 'Disallow: /';
+    for (const bot of AEO_TRAINING_BOTS) lines.push('User-agent: ' + bot, verdict, '');
+    lines.push('Sitemap: ' + sitemapUrl);
+    robots = lines.join('\n').replace(/\n+$/, '\n');
+  } else {
+    robots = '# Robots.txt\nUser-agent: *\nAllow: /\n\nSitemap: ' + sitemapUrl + '\n';
+  }
   fs.writeFileSync(path.join(outputDir, 'robots.txt'), robots);
   console.log('robots.txt generated');
 }
